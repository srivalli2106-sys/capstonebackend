# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# Environment: development | test | production
APP_ENV=development

# Enable debug logging/behavior
DEBUG=false

# Server bind address and port
HOST=0.0.0.0
PORT=8000

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------------
# Connection string (Atlas or local). In production, must be a real value.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net
# Database name
MONGODB_DB=secure_messaging
# Optional connection/pool tuning (defaults shown):
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# MONGODB_SOCKET_TIMEOUT_MS=
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=0
# MONGODB_MAX_IDLE_TIME_MS=300000

# ------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------
# Connection URL (optional for local development; required for production
# rate limiting / presence / offline queue).
REDIS_URL=redis://localhost:6379/0
# Optional client tuning (defaults shown):
# REDIS_MAX_CONNECTIONS=10
# REDIS_SOCKET_CONNECT_TIMEOUT=3
# REDIS_SOCKET_TIMEOUT=5
# REDIS_HEALTH_CHECK_INTERVAL=30

# ------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------
# Secret used to sign/verify tokens. In development the built-in default is
# used if unset. In production this MUST be a strong, random value and is
# required. The placeholder below is deliberately REJECTED by production
# validation — generate a real secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
JWT_SECRET=change-me-to-a-long-random-string
# Signing algorithm
JWT_ALGORITHM=HS256
# Token lifetime in hours
JWT_EXPIRY_HOURS=24
# Issuer claim: validated on every token verification.
JWT_ISSUER=secure-messaging-api

# ------------------------------------------------------------------
# Authentication (proof of possession)
# ------------------------------------------------------------------
# Lifetime (seconds) of a challenge issued by POST /auth/challenge before the
# client must complete POST /auth/verify.
AUTH_CHALLENGE_TTL_SECONDS=120

# ------------------------------------------------------------------
# WebSocket
# ------------------------------------------------------------------
# Maximum seconds a client has to complete the first-frame auth handshake
# ({"type": "auth", "token": "<JWT>"}) before the connection is closed (4001).
# WS_AUTH_TIMEOUT_SECONDS=10
# Hard per-process cap on concurrent WebSocket connections.
# WS_MAX_CONNECTIONS=1000
# Per-IP cap on concurrent WebSocket connections (0 disables; global budget
# still applies).
# WS_MAX_CONNECTIONS_PER_IP=20
# Seconds a connection may stay silent before it is closed (0 disables).
# The server's keepalive pings (below) reset this window on healthy peers.
# WS_IDLE_TIMEOUT_SECONDS=180
# Seconds between server-initiated WebSocket ping frames (keepalive; must be
# smaller than the idle timeout so healthy connections are never condemned).
# WS_KEEPALIVE_SECONDS=30
# Lifetime (seconds) of Redis presence/connection markers, refreshed every
# half-life while a connection is alive.
# WS_PRESENCE_TTL_SECONDS=300
# Redis sliding-window rate limits: connection attempts (per IP per minute)
# and inbound messages (per user per minute).
# WS_CONNECT_RATE_PER_MINUTE=60
# WS_MESSAGE_RATE_PER_MINUTE=120

# ------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------
# Comma-separated list of allowed origins for browser-based clients.
#
#   * Unset or "*": development/testing default — browsers from any origin
#     are permitted. Production REJECTS "*".
#   * One or more specific origins (e.g. "https://app.example.com"):
#     only those origins are permitted. Required in production.
#   * Explicitly empty (CORS_ORIGINS= with no value): production-safe "no
#     browser origins allowed" — used when the deployment has no frontend
#     yet. The middleware allows no browser cross-origin requests but
#     same-origin and non-browser traffic are unaffected.
CORS_ORIGINS=*

# ------------------------------------------------------------------
# Security / transport
# ------------------------------------------------------------------
# Comma-separated list of acceptable Host header values. "*" (development
# default) disables host validation. Production requires explicit hosts and
# rejects "*". Example: https://api.example.com when behind a proxy.
# ALLOWED_HOSTS=localhost,127.0.0.1

# Set true ONLY when this deployment is served over TLS (HTTPS/WSS, typically
# behind a TLS-terminating proxy). Production requires it; it gates the
# Strict-Transport-Security header so HSTS is never emitted over plaintext
# local HTTP.
# SECURE_TRANSPORT=false
#
# Example production values (also see docs/DEPLOYMENT.md):
#   ALLOWED_HOSTS=api.example.com
#   SECURE_TRANSPORT=true