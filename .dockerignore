# Version control / CI
.git
.gitignore
.github

# Local environment & secrets (never build them into the image)
.env
.env.*
!.env.example

# Virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / tooling caches and reports
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# Source not needed at runtime
tests/
docs/
pyproject.toml
requirements-dev.txt
README.md

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# IDE / editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db